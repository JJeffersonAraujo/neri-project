generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/*
 ENUMS
*/
enum Role {
  ADMIN
  GESTOR
  PROFISSIONAL
}

/*
 MODELS
*/

model Usuario {
  id         Int      @id @default(autoincrement())
  nome       String
  email      String   @unique
  senhaHash  String   @map("senha_hash")
  role       Role
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  profissional Profissional?
  sessoes      AuthSessao[]

  @@index([email])
}

model AuthSessao {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model TipoProfissional {
  id        Int      @id @default(autoincrement())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  profissionais Profissional[]
  atividades    Atividade[]
}

model Profissional {
  id                Int      @id @default(autoincrement())
  usuarioId          Int      @unique
  tipoProfissionalId Int
  conselho           String
  numeroRegistro     String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  usuario          Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipoProfissional TipoProfissional @relation(fields: [tipoProfissionalId], references: [id])
  plantoes         Plantao[]

  @@index([tipoProfissionalId])
}

model Escala {
  id         Int      @id @default(autoincrement())
  nome       String
  dataInicio DateTime
  dataFim    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  plantoes Plantao[]
}

model Plantao {
  id             Int      @id @default(autoincrement())
  escalaId       Int
  profissionalId Int
  data           DateTime
  horaInicio     DateTime
  horaFim        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  escala       Escala       @relation(fields: [escalaId], references: [id])
  profissional Profissional @relation(fields: [profissionalId], references: [id])
  atividades   Atividade[]

  @@index([data])
}

model Paciente {
  id             Int      @id @default(autoincrement())
  nome           String
  dataNascimento DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  atendimentos Atendimento[]
}

model Atendimento {
  id         Int      @id @default(autoincrement())
  pacienteId Int
  descricao  String
  horario    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  paciente   Paciente   @relation(fields: [pacienteId], references: [id])
  atividades Atividade[]

  @@index([pacienteId])
}

model Atividade {
  id                 Int      @id @default(autoincrement())
  plantaoId          Int
  atendimentoId      Int
  tipoProfissionalId Int
  descricao          String
  horario            DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  plantao         Plantao         @relation(fields: [plantaoId], references: [id])
  atendimento     Atendimento     @relation(fields: [atendimentoId], references: [id])
  tipoProfissional TipoProfissional @relation(fields: [tipoProfissionalId], references: [id])

  @@index([plantaoId])
}
