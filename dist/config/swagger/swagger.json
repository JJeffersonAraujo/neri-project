{
    "openapi": "3.0.0",
    "components": {
        "examples": {},
        "headers": {},
        "parameters": {},
        "requestBodies": {},
        "responses": {},
        "schemas": {
            "CreateUserDTO": {
                "properties": {
                    "nome": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "senha": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "ADMIN",
                            "GESTOR",
                            "PROFISSIONAL",
                            "USER"
                        ]
                    }
                },
                "required": [
                    "nome",
                    "email",
                    "senha",
                    "role"
                ],
                "type": "object",
                "additionalProperties": true
            },
            "UpdateUserDTO": {
                "properties": {
                    "nome": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "senha": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "ADMIN",
                            "GESTOR",
                            "PROFISSIONAL",
                            "USER"
                        ]
                    }
                },
                "type": "object",
                "additionalProperties": true
            },
            "AuthResponse": {
                "properties": {
                    "token": {
                        "type": "string"
                    },
                    "refreshToken": {
                        "type": "string"
                    },
                    "user": {
                        "properties": {
                            "role": {
                                "type": "string"
                            },
                            "email": {
                                "type": "string"
                            },
                            "nome": {
                                "type": "string"
                            },
                            "id": {
                                "type": "number",
                                "format": "double"
                            }
                        },
                        "required": [
                            "role",
                            "email",
                            "nome",
                            "id"
                        ],
                        "type": "object"
                    }
                },
                "required": [
                    "token",
                    "refreshToken",
                    "user"
                ],
                "type": "object",
                "additionalProperties": true
            },
            "Error": {
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "stack": {
                        "type": "string"
                    }
                },
                "required": [
                    "name",
                    "message"
                ],
                "type": "object",
                "additionalProperties": true
            },
            "LoginDTO": {
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "senha": {
                        "type": "string"
                    }
                },
                "required": [
                    "email",
                    "senha"
                ],
                "type": "object",
                "additionalProperties": true
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    },
    "info": {
        "title": "neri-project",
        "version": "1.0.0",
        "description": "Projeto NeriCare - Express + TypeScript com TSOA",
        "license": {
            "name": "ISC"
        },
        "contact": {
            "name": "Jefferson Araujo"
        }
    },
    "paths": {
