        "/auth/login": {
            "post": {
                "operationId": "Login",
                "responses": {
                    "200": {
                        "description": "Login realizado com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthResponse"
                                },
                                "examples": {
                                    "Example 1": {
                                        "value": {
                                            "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                                            "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                                            "user": {
                                                "id": 1,
                                                "nome": "Jefferson",
                                                "email": "admin@email.com",
                                                "role": "ADMIN"
                                            }
                                        }
                                    }
                                }
                            }
