{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "typeRoots": ["./src/@types", "./node_modules/@types"],

    "rootDir": "./src",
    "outDir": "./dist",
    "ignoreDeprecations": "6.0",

    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"]
    },

    "experimentalDecorators": true,

    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
